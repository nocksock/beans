#!/usr/bin/env bash
# Attach to or create a tmux session for the current bean.
# If session exists, attach to it. If not, create a new one.
#
# Environment variables:
#   BEANS_ID    - The bean ID (e.g., "beans-abc123")
#   BEANS_TASK  - The bean title (e.g., "Fix bug in parser")
#   BEANS_DIR   - The .beans directory path
#   BEANS_ROOT  - The project root directory

set -e

BEAN_ID="${BEANS_ID:-}"
BEAN_TASK="${BEANS_TASK:-}"
PROJECT_ROOT="${BEANS_ROOT:-.}"

if [[ -z "$BEAN_ID" ]]; then
    echo "Error: BEANS_ID not set" >&2
    exit 1
fi

# Sanitize bean ID for use as tmux session name
SESSION_NAME="beans-${BEAN_ID//[^a-zA-Z0-9_-]/}"

# If session exists, just attach
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    exec tmux attach-session -t "$SESSION_NAME"
fi

# Create new session in the project root
# -d: detach others, -s: session name
# Start with a shell that users can then run their commands in
tmux new-session -d -s "$SESSION_NAME" -c "$PROJECT_ROOT"

# Set the session title to the bean task
tmux rename-session -t "$SESSION_NAME" "$BEAN_TASK"

# Attach to the session
exec tmux attach-session -t "$SESSION_NAME"
