#!/usr/bin/env bash
# Shorten text from stdin to a label of at most 20 characters using Claude Haiku.
# Falls back to plain truncation if claude fails.
#
# Usage: echo "Some long bean title" | ./scripts/shorten

set -euo pipefail

MAX=20
input=$(cat)
[[ -n "$input" ]] || exit 0

short=$(claude -p --model haiku \
  "Shorten the following text to a concise label of at most $MAX characters. Output only the label, nothing else." \
  <<<"$input" 2>/dev/null | head -n1 | tr -d '\r') || short=""

[[ -n "$short" ]] || short="$input"

printf '%s\n' "${short:0:$MAX}"
