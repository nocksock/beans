#!/usr/bin/env bash
# Print the agent prompt for a bean: the bean itself plus notes that depend on
# where and how the agent runs.
#
# Usage: scripts/bean-prompt [--tmux] [--worktree DIR] [bean-id]   (defaults to $BEANS_ID)
#   --tmux          the agent runs in its own tmux window: rename it, close it when done
#   --worktree DIR  the agent runs in the bean's worktree DIR: add cleanup instructions

set -euo pipefail

TMUX_WINDOW=false
WORKTREE_DIR=""
while [[ $# -gt 0 ]]; do
    case $1 in
        --tmux) TMUX_WINDOW=true; shift ;;
        --worktree) WORKTREE_DIR="$2"; shift 2 ;;
        *) break ;;
    esac
done

BEANS_ID="${1:-${BEANS_ID:-}}"
[[ -n "$BEANS_ID" ]] || { echo "Error: no bean id given and BEANS_ID not set" >&2; exit 1; }

HUB=$(cd "$(dirname "$0")/.." && pwd)

beans show --prompt "$BEANS_ID"

# The agent renames the window itself once it knows what the bean is about
if $TMUX_WINDOW; then
    cat <<'EOF'

## tmux window

You are running in a tmux window. Before starting, rename it to `<bean-id>: <label>`, where <label> is a short summary of this bean of at most 20 characters:
`tmux rename-window -t "$TMUX_PANE" '<bean-id>: <label>'`
EOF
fi

# Unquoted heredoc: paths are baked in, \$TMUX_PANE must resolve in the agent's window
if [[ -n "$WORKTREE_DIR" ]]; then
    cat <<EOF

## Cleanup when done

This bean runs in the worktree $WORKTREE_DIR on branch task/$BEANS_ID. Clean up only after the user has explicitly declared the work done. Never on your own initiative, and never because the bean is marked completed.

Once the user has declared the work done, first bring the branch up to date with dev:
- Commit any remaining work on task/$BEANS_ID.
- Merge dev into the task branch: \`git -C "$WORKTREE_DIR" merge dev\`. If it conflicts, resolve the conflicts here in the worktree, run the tests, and commit the merge. If you cannot resolve a conflict with confidence, stop and ask the user.

Only then ask them with your question tool, offering exactly these two options:
- "Merge into dev, cleanup": merge the task branch into dev with \`git -C "$HUB/dev" merge --no-ff task/$BEANS_ID\`. Since dev was merged in first, this must apply cleanly; if it conflicts anyway or the dev worktree has uncommitted changes, stop and tell the user. Then run the steps below.
- "Merged, cleanup": the user has merged it already. Run the steps below.

1. Confirm the merge: \`git -C "$HUB" merge-base --is-ancestor task/$BEANS_ID dev\` must succeed. If it fails, stop and tell the user.
2. Check the related beans (parent, children, blocking and blocked-by; see \`beans show $BEANS_ID\`). If decisions or outcomes of this work affect any of them, update them with \`beans update\`, e.g. their body, status or blocking links, and tell the user what you changed.
3. Mark the bean completed and commit it in the hub together with any related bean updates: \`beans update $BEANS_ID --status completed && git -C "$HUB" add .beans && git -C "$HUB" commit -m "chore: complete $BEANS_ID"\`
4. Remove the worktree: \`git -C "$HUB" worktree remove "$WORKTREE_DIR"\`. Do not pass --force; if it refuses because of uncommitted changes, stop and tell the user.
5. Delete the branch from the dev worktree, so -d checks it against dev: \`git -C "$HUB/dev" branch -d task/$BEANS_ID\`
EOF
    if $TMUX_WINDOW; then
        cat <<'EOF'
6. Close this tmux window as the very last step, since it ends this session: `tmux kill-window -t "$TMUX_PANE"`
EOF
    fi
fi

# Draft beans get planned before any implementation
if [[ "$(beans show --json "$BEANS_ID" | jq -r .status)" == draft ]]; then
    cat <<EOF

## Draft: plan first

This bean is still a draft. Do not implement anything yet. Plan the feature first: work out the requirements and open questions with the user, then write the agreed plan into the bean body. Once the plan is done, set the status to in-progress with \`beans update $BEANS_ID --status in-progress\` and commit the bean change in the hub.
EOF
fi
