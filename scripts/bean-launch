#!/usr/bin/env bash
# Launch a coding agent on a bean, composed from three independent choices:
#   where  - the dev worktree (default) or the bean's own worktree (--worktree)
#   host   - this terminal (default), a new tmux window (--tmux) or kitty window (--kitty)
#   agent  - see scripts/bean-agent
#
# Usage: scripts/bean-launch [--worktree] [--tmux|--kitty] <agent>
#   e.g. scripts/bean-launch --worktree --tmux opencode

set -euo pipefail

WORKTREE=false
HOST=terminal
while [[ $# -gt 0 ]]; do
    case $1 in
        --worktree) WORKTREE=true; shift ;;
        --tmux) HOST=tmux; shift ;;
        --kitty) HOST=kitty; shift ;;
        *) break ;;
    esac
done
AGENT="${1:?Usage: $0 [--worktree] [--tmux|--kitty] <agent>}"
: "${BEANS_ID:?BEANS_ID not set}"

SCRIPTS=$(cd "$(dirname "$0")" && pwd)
HUB=$(dirname "$SCRIPTS")

PROMPT_ARGS=()
if $WORKTREE; then
    DIR="$("$SCRIPTS/bean-worktree")"
    PROMPT_ARGS+=(--worktree "$DIR")
else
    DIR="$HUB/dev"
fi
[[ $HOST == tmux ]] && PROMPT_ARGS+=(--tmux)

PROMPT="$("$SCRIPTS/bean-prompt" "${PROMPT_ARGS[@]}")"

case $HOST in
    terminal)
        cd "$DIR"
        BEANS_PROMPT="$PROMPT" exec "$SCRIPTS/bean-agent" "$AGENT"
        ;;
    tmux)
        tmux new-window -c "$DIR" -n "$BEANS_ID" -e "BEANS_PROMPT=$PROMPT" \
            "$(printf '%q %q' "$SCRIPTS/bean-agent" "$AGENT")"
        ;;
    kitty)
        kitty @ launch --type=window --cwd="$DIR" --env "BEANS_PROMPT=$PROMPT" \
            "$SCRIPTS/bean-agent" "$AGENT"
        ;;
esac
